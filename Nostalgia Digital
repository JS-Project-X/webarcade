          "type": "gbc",
          "background": "https://raw.githubusercontent.com/webrcade-assets/webrcade-assets-gbc-images/master/Named_Snaps/output/Harry%20Potter%20and%20the%20Chamber%20of%20Secrets%20(USA%2C%20Europe)%20(En%2CFr%2CDe%2CEs%2CIt%2CNl%2CPt%2CSv%2CDa).png",
