        {
          "type": "arcade-konami",
          "title": "Gyruss",
          "longTitle": "Gyruss (Konami)",
          "background": "https://raw.githubusercontent.com/webrcade-assets/webrcade-assets-fbneo-images/master/Named_Snaps/output/Gyruss%20(Konami).png",
