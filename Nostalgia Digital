        {
          "title": "Kingdom Hearts - Chain of Memories",
          "longTitle": "Kingdom Hearts - Chain of Memories (USA)",
          "type": "gba",
          "background": "https://raw.githubusercontent.com/webrcade-assets/webrcade-assets-gba-images/master/Named_Snaps/output/Kingdom%20Hearts%20-%20Chain%20of%20Memories%20(USA).png",
