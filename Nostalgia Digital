        {
          "title": "Final Fantasy I & II - Dawn of Souls",
          "longTitle": "Final Fantasy I & II - Dawn of Souls (USA)",
          "type": "gba",
          "background": "https://raw.githubusercontent.com/webrcade-assets/webrcade-assets-gba-images/master/Named_Snaps/output/Final%20Fantasy%20I%20%26%20II%20-%20Dawn%20of%20Souls%20(USA).png",
