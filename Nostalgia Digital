        {
          "props": {
            "uid": "eef4d3c9-cb25-4e27-8e0b-e9f23858e884",
            "discs": [
              "https://archive.org/download/EF_PC-FX_Collection/PC-FX/Doukyuusei%202%20%28Japan%29.zip"
            ]
          },
          "type": "pcfx",
          "title": "Doukyuusei 2",
          "description": "Dokyusei is a classic \"love adventure\", a genre that is also referred to (quite erroneously) as \"dating simulations\". You are a high-school student, whose father is a famous archaeologist traveling around the world, and whose mother died when he was a child. It is now your third year at the 88 High School, and naturally, your primary concern is your love life. Will you be able to date successfully and to come to a happy ending with one of the fifteen lovely female classmates? The game mechanics are a lot like in a \"standard\" adventure game (examine objects, visit various locations, talk to people, make decisions), but the plot centers exclusively around your relationship with the girls. The game has its own internal clock. You can move around your character on a \"city map\", visiting different locations. Every visit takes 20-30 minutes of game time. You can make appointments and visit various places at a specific time. The decisions you make influence the story.",
          "thumbnail": "https://raw.githubusercontent.com/webrcade-assets/webrcade-assets-pcfx-images/master/Named_Titles/resized/Doukyuusei%202%20(NEC%20Avenue)%20(Japan)%5BFXNAV601%5D.png",
          "background": "https://raw.githubusercontent.com/webrcade-assets/webrcade-assets-pcfx-images/master/Named_Snaps/output/Doukyuusei%202%20(NEC%20Avenue)%20(Japan)%5BFXNAV601%5D.png",
          "backgroundPixelated": true,
