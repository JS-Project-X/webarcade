          "type": "arcade-capcom",
          "title": "1941 - Counter Attack",
          "longTitle": "1941 - Counter Attack (900227 World)",
          "background": "https://th.bing.com/th/id/OIP.caflQuh22Re9MBDX4b27_AHaFj?w=228&h=180&c=7&r=0&o=5&pid=1.7",
