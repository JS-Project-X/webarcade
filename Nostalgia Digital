        {
          "title": "Mega Man Battle Network 3 - Blue Version",
          "longTitle": "Mega Man Battle Network 3 - Blue Version (USA)",
          "type": "gba",
          "background": "https://raw.githubusercontent.com/webrcade-assets/webrcade-assets-gba-images/master/Named_Snaps/output/Mega%20Man%20Battle%20Network%203%20-%20Blue%20Version%20(USA).png",
          "thumbnail": "https://raw.githubusercontent.com/webrcade-assets/webrcade-assets-gba-images/master/Named_Titles/resized/Mega%20Man%20Battle%20Network%203%20-%20Blue%20Version%20(USA).png",
          "description": "LAN, the young hero, is invited to attend a local net-battle tournament with his Personal Electronic Trained character, Mega Man. However, during the tournament, Mega Man and LAN discover a plot by an evil corporation, who hope to once again take over the network.\n\nUsing an RPG style, you must guide Mega Man through various levels defeating enemies along the way and collecting the various chips to upgrade Mega Man's weapons and other items.\n\nExclusive to this, the Blue Version, are specialy developed chips (Giga Class chips) that only the Blue Version of Mega Man can use. You can also trade various chips between players using either Blue or White versions of BN3.",
          "backgroundPixelated": true,
          "props": {
            "rom": "https://archive.org/download/2DisneyGamesDisneySportsFootballDisneySportsSkateboardingEuropeEnFrDeEsIt/Mega%20Man%20Battle%20Network%203%20-%20Blue%20Version%20%28USA%29.gba"
