        {
          "title": "Fun House",
          "longTitle": "Fun House (USA)",
          "type": "nes",
          "background": "https://raw.githubusercontent.com/webrcade-assets/webrcade-assets-nes-images/master/Named_Snaps/output/Fun%20House%20(USA).png",
