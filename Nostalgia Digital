          "background": "https://raw.githubusercontent.com/webrcade-assets/webrcade-assets-psx-images/master/Named_Snaps/output/Ehrgeiz%20-%20God%20Bless%20the%20Ring%20(Europe).png",
          "backgroundPixelated": true,
          "added": 1747687316538
        },
