          "type": "gba",
          "background": "https://raw.githubusercontent.com/webrcade-assets/webrcade-assets-gba-images/master/Named_Snaps/output/Mazes%20of%20Fate%20(USA)%20(En%2CFr%2CDe%2CEs%2CIt).png",
