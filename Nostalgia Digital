          "type": "gba",
          "background": "https://raw.githubusercontent.com/webrcade-assets/webrcade-assets-gba-images/master/Named_Snaps/output/Mary-Kate%20and%20Ashley%20-%20Girls%20Night%20Out%20(USA%2C%20Europe).png",
