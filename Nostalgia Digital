          "type": "arcade",
          "title": "Guerrilla War",
          "longTitle": "Guerrilla War (Joystick hack bootleg)",
          "background": "https://raw.githubusercontent.com/webrcade-assets/webrcade-assets-fbneo-images/master/Named_Snaps/output/Guerrilla%20War%20(Joystick%20hack%20bootleg).png",
