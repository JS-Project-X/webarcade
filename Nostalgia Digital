        {
          "title": "Spectron",
          "longTitle": "Spectron",
          "type": "coleco",
          "background": "https://raw.githubusercontent.com/webrcade-assets/webrcade-assets-coleco-images/master/Named_Titles/resized/Spectron%20(USA).png",
