          "title": "Time Trax",
          "longTitle": "Time Trax (USA)",
          "type": "snes",
          "background": "https://raw.githubusercontent.com/webrcade-assets/webrcade-assets-snes-images/master/Named_Snaps/output/Time%20Trax%20(USA).png",
