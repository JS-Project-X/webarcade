        {
          "title": "Doraemon - Nobita no Dorabian Night",
          "longTitle": "Doraemon - Nobita no Dorabian Night (Japan)",
          "type": "pce",
          "background": "https://raw.githubusercontent.com/webrcade-assets/webrcade-assets-pce-images/master/Named_Snaps/output/Doraemon%20-%20Nobita%20no%20Dorabian%20Night%20(Japan).png",
