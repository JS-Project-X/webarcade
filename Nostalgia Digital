        {
          "title": "Flying Dragon - The Secret Scroll",
          "longTitle": "Flying Dragon - The Secret Scroll (USA)",
          "type": "nes",
          "background": "https://raw.githubusercontent.com/webrcade-assets/webrcade-assets-nes-images/master/Named_Snaps/output/Flying%20Dragon%20-%20The%20Secret%20Scroll%20(USA).png",
