          "type": "gba",
          "background": "https://raw.githubusercontent.com/webrcade-assets/webrcade-assets-gba-images/master/Named_Snaps/output/American%20Dragon%20-%20Jake%20Long%20-%20Rise%20of%20the%20Huntsclan%20(USA%2C%20Europe)%20(En%2CFr%2CDe%2CEs%2CIt).png",
